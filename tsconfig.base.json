{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@readyup/pose-types": ["packages/pose-types/src/index.ts"],
      "@readyup/exercise": ["packages/exercise/src/index.ts"],
      "@readyup/sim": ["packages/sim/src/index.ts"],
      "@readyup/session": ["packages/session/src/index.ts"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
